################################################################################
# HELPER FILE TO FIND HOW MANY INEQUIVALENT Q-POINTS IN PHONON CALCULATION
# NO ACTUAL CALCULATION IS DONE HERE
################################################################################
outdata_prefix "./outdata/0_qptgen/qptgen"

acell 6.2552223835 6.2552223835 6.2552223835 Bohr
rprim -0.5  0.5  0.5
       0.5 -0.5  0.5
       0.5  0.5 -0.5

ntypat 1
znucl 41
pp_dirpath "../"
pseudos "Nb.psp8"

natom 1
typat 1
xred 0.0 0.0 0.0

ecut 14

kptopt 1                                                                        # k-points setup method;
                                                                                # 1: only k-points within irreducible BZ generated
ngkpt 4 4 4                                                                     # set-up k-points as you would set up q-points
nshiftk 1
shiftk 0 0 0

nstep 1                                                                         # no real calculation done,
nline 1                                                                         # I just want to set up q points for phonon calculation

tolvrs 1.0d-18
