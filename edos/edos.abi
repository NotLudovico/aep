###############################################################################
# PREAMBLE
################################################################################
outdata_prefix "./outdata/edos-fermi"                                           # path prefix for output data files
ndtset 2                                                                        # number of datasets (one for SCF procedure to get GS electron density, one for band structure calculation)

################################################################################
# UNIT CELL
################################################################################
acell  6.2360  6.2360  6.2360
rprim
 -0.5  0.5  0.5
  0.5 -0.5  0.5
  0.5  0.5 -0.5

# ---------------------
# Species & atoms (single-atom primitive cell)
# --------------------
ntypat 1
znucl  41                         # Nb
natom  1
typat  1
xred
  0.0  0.0  0.0                   # single atom at the lattice point

# --------------------
# Pseudopotential
# --------------------
pp_dirpath "../"
pseudos    "Nb.psp8"

# --------------------
# Global defaults (overridden by per-dataset lines below)
# --------------------
# Plane waves (used by k-mesh sweep datasets 10..14)
ecut    33

# K-point sampling (used by ecut sweep datasets 1..9)
kptopt  1
ngkpt   8 8 8
nshiftk 1
shiftk  0.5 0.5 0.5

occopt 4                                                                        # controls how occupation of electronic states is handled (see https://docs.abinit.org/variables/basic/#occopt)
                                                                                # when occopt = 4, the "cold smearing" of Marzari is used
                                                                                # smearing improves convergence w.r.t. to BZ sampling in metals, where state occupation drops suddenly to zero as Fermi level crossed
                                                                                # otherwise, a very fine mesh would be needed for accurate integration around the discontinuity
tsmear 0.004                                                                     # [Ha] "temperature" of smearing
                                                                                # convergence should be checked also w.r.t. this parameter
                                                                                # see http://theossrv1.epfl.ch/Main/ElectronicTemperature

################################################################################
# SCF PROCEDURE (DATASET 1)
################################################################################
nstep1 20                                                                       # max. number of SCF cycles
toldfe1 1.0d-6                                                                  # convergence criterion: absolute energy difference between two consecutive steps
diemac1 1e6                                                                     # (optional) pre-conditioning of macroscopic dielectric constant; very large for metals; might significantly speed up computation (see https://docs.abinit.org/variables/gstate/#diemac)
prtden1  1                                                                      # save density from SCF procedure (dataset1), so that it can be used in the non-self-consistent calculation of band structure (dataset 2)

################################################################################
# DENSITY-OF-STATES AND FERMI SURFACE (DATASET 2)
################################################################################
ngkpt2 30 30 30                                                                 # number of grid points for DOS calculation (dataset 2);
nshiftk2 1                                                                      # many more points needed to have a fine sampling of BZ;
shiftk2 0.0 0.0 0.0
iscf2 -3                                                                        # self-consistency of the calculation;
                                                                                # 0: SCF cycle,
                                                                                # -2: non-SCF calculation
                                                                                # (electron density from previous dataset - SCF cycle);
                                                                                # -3: like -2, but initialize occupation
                                                                                # (see https://docs.abinit.org/variables/basic/#iscf)
getden2 -1                                                                      # get density from previous step
tolwfr2 1.0d-12                                                                 # tolerance on wavefunction squared residual
nband2 18                                                                        # number of bands (if unsure, look at 'nband'
                                                                                # in output file of SCF cycle and add some more)
enunit2 1                                                                       # output energies in eV instead of Ha
prtdos2 2                                                                       # save density-of-states;
                                                                                # 2: use the tetrahedron method to calculate it
                                                                                # (see https://docs.abinit.org/variables/files/#prtdos)
prtfsurf2 1                                                                     # save data for Fermi surface plot in BXSF format
                                                                                # (readable by XCrysDen)
