################################################################################
# HELPER FILE TO GENERATE INEQUIVALENT Q-POINTS FOR THE ACTUAL CALCULATION.
# NO ACTUAL CALCULATION IS DONE HERE
################################################################################
outdata_prefix "./outdata/0_qptgen/qptgen"

acell  4.7452903429E+00  4.7452903429E+00  1.6158145952E+01
rprim  1.0000000000E+00  0.0000000000E+00  0.0000000000E+00
      -5.0000000000E-01  8.6602540378E-01  0.0000000000E+00
       0.0000000000E+00  0.0000000000E+00  1.0000000000E+00

ntypat 2
znucl 5 7
pp_dirpath "../../../pseudos/pseudo-dojo_nc_sr_pbe_standard"
pseudos "B.psp8, N.psp8"

natom 4
typat 1 1 2 2
xred  2.3314068038E-28  2.3117470367E-28  5.0000000000E-01
      3.3333333333E-01  6.6666666667E-01 -1.8841942557E-31
      2.8470500500E-27  4.8209414655E-27 -1.3288451039E-31
      3.3333333333E-01  6.6666666667E-01  5.0000000000E-01

ecut 42.0

kptopt 1                                                                        # k-points setup method; 1: only k-points within irreducible BZ will be generated
ngkpt 8 8 4
nshiftk 1
shiftk 0 0 0

nstep 1                                                                         # no real calculation done, I just want to set up q points for phonon calculation
nline 1
tolvrs 1.0d-18
