################################################################################
# PREAMBLE
################################################################################
outdata_prefix "./outdata/1_response/response"                                  # path prefix for output data files
ndtset 146                                                                      # number of datasets:
                                                                                # 1: initial GS SCF calculation,
                                                                                # 2-: response to phonons and e-ph matrix elements
                                                                                # the number of irreducible q-points has been checked
                                                                                # with previous dummy run

################################################################################
# PHONON- AND E-PH-RELATED DEFAULT SETTINGS
################################################################################
nqpt 1                                                                          # read q-point (ABINIT considers one q point per dataset)
rfphon 1                                                                        # calculate response function to q-phonon
tolvrs 1.0d-8                                                                   # convergence based on residual of potential
getwfk 1                                                                        # use wavefunction from dataset 1 (GS calculation)

qptopt 1                                                                        # q-point grid generation
ngqpt 16 16 16                                                                  # same meanings as k-point related vars
nshiftq 1
shiftq 0 0 0

# specify which q-point from the grid to use for each dataset,
# by index in the list of q-points
iqpt: 0                                                                         # start q-point: iqpt=0 => q = 0 0 0
iqpt+ 1                                                                         # increment iqpt by 1 at each dataset
                                                                                # iqpt=1 => q = 0 0 0
                                                                                # at last dataset (9), iqpt=8 (max. index)

# e-ph related default settings
prepgkk 1                                                                       # do not reduce perturbations by symmetry
use_nonscf_gkk 0                                                                # calculate all GKK matrix elements self-consistently
                                                                                # not only the irreducible ones
prtgkk 1                                                                        # print out e-ph matrix elements
prtwf 0                                                                         # do not print out wave function (save disk space)

################################################################################
# DATASET 1: GROUND-STATE CALCULATION - OVERRIDE DEFAULT SETTINGS ABOVE AND BELOW
################################################################################
getwfk1 0                                                                       # no wavefunction from previous calculation
nqpt1 0                                                                         # do not read q-point
rfphon1 0                                                                       # do not apply phonon perturbation
prtgkk1 0                                                                       # do not print out e-ph matrix elements

tolwfr1 1.0d-20                                                                 # SCF convergence criterion: residual of the wavefunction
                                                                                # a very tight value is needed to get good e-ph matrix elements
prtwf1 1                                                                        # print wavefunction for subsequent datasets

################################################################################
# UNIT CELL
################################################################################
acell 6.2552223835 6.2552223835 6.2552223835 Bohr
rprim -0.5  0.5  0.5
       0.5 -0.5  0.5
       0.5  0.5 -0.5

################################################################################
# ATOM TYPES
################################################################################
ntypat 1                                                                        # number of atom types
znucl 41                                                                        # atomic number of the atom types (space-separated)
pp_dirpath "../" 
pseudos "Nb.psp8"                                                               # pseudopotential file names (within quotation marks, comma-separated)

################################################################################
# ATOMS
################################################################################
natom 1                                                                         # Al has FCC structure, with one atom per unit cell
typat 1                                                                         # atom types (must be consistent with 'znucl' and 'pseudos' order)
xred 0.0 0.0 0.0                                                                # atom fractional coordinates within unit cell

################################################################################
# PLANE-WAVE BASIS SET
################################################################################
ecut 44                                                                          # [Ha] cut-off energy

################################################################################
# NUMBER OF BANDS
################################################################################
nband 16

################################################################################
# k-POINT GRID
################################################################################
kptopt 3                                                                        # do not account for symmetry when generating k-vectors
ngkpt 30 30 30                                                                  # number of grid points
                                                                                # number of k vectors must be multiple of number of q vectors
nshiftk 1                                                                       # number of shifted grids
shiftk 0.0 0.0 0.0                                                              # k-grid shift vectors

################################################################################
# OCCUPATION
################################################################################
occopt 4
tsmear 0.002

################################################################################
# SCF PROCEDURE
################################################################################
nstep 10000                                                                     # max. number of SCF cycles
